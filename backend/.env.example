# CyberGuardian AI Backend Configuration Template
# Copy this file to .env and replace placeholder values for production.

# Application Settings
PROJECT_NAME="CyberGuardian AI"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Database & Cache
DATABASE_URL="sqlite:///./cyberguardian.db"
REDIS_URL="redis://localhost:6379/0"

# Security & Authentication
SECRET_KEY="generate-a-secure-random-64-char-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Services & API Keys
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Strix AI Penetration Testing Agent Configuration
STRIX_ENABLED=true
STRIX_LLM="openrouter/z-ai/glm-5.3"
STRIX_MAX_BUDGET=10.0
STRIX_TIMEOUT_SECONDS=300

# Integrations & Notifications
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
HIBP_API_KEY=""

# SMTP Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="no-reply@cyberguardian.ai"
EMAILS_FROM_NAME="CyberGuardian AI"
SMTP_TLS=true
SMTP_SSL=false
